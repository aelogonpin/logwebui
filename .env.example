# Copy this file to .env and fill in your values.
# LokiViews reads configuration exclusively from environment variables (12-Factor App).

# Base URL of the Loki server (no trailing slash needed).
LOKI_URL=https://loki.monitoring.seidor-retail.com

# Basic Auth credentials for Loki.
LOKI_USER=changeme
LOKI_PASS=changeme

# Optional. X-Scope-OrgID is entered per-query in the web UI (the Org ID
# field), since Loki tenants can vary per request. Set this only if you
# want that field pre-filled with a default when the app loads.
LOKI_ORG_ID=Clarel-pro

# Optional: port the HTTP server listens on. Defaults to 8080.
PORT=8080
