# Copy this file to .env and fill in your values.
# LokiViews reads configuration exclusively from environment variables (12-Factor App).

# Base URL of the Loki server (no trailing slash needed).
LOKI_URL=https://loki.example.com

# Basic Auth credentials for Loki.
LOKI_USER=changeme
LOKI_PASS=changeme

# Optional. X-Scope-OrgID is entered per-query in the web UI (the Org ID
# field), since Loki tenants can vary per request. Set this only if you
# want that field pre-filled with a default when the app loads.
LOKI_ORG_ID=acme-prod

# Optional: port the HTTP server listens on. Defaults to 8080.
PORT=8080

# Optional: enables the "Discover tenants" button next to the Org ID field.
# It queries Mimir for the "tenant" label on Loki's own self-monitoring
# metrics (loki_distributor_bytes_received_total), listing which Org IDs
# actually have data. Leave MIMIR_URL empty/unset to disable the feature
# entirely — it won't even appear in the UI.
MIMIR_URL=
MIMIR_USER=
MIMIR_PASS=
# Optional: X-Scope-OrgID that Mimir itself expects (only if Mimir is
# multi-tenant), separate from any Loki org ID. IMPORTANT: this is NOT
# necessarily the Loki tenant name — if there's a proxy like cortex-tenant
# in front of Mimir, it decides the tenant from some OTHER label on the
# metric (e.g. "cluster"), so this must match whatever value that ends up
# being. See "Autodescubrimiento de tenants (Mimir)" in README.md for how
# to find the right value and how to tell "wrong tenant" apart from
# "metric isn't being sent to Mimir at all" (both look like an empty list
# from the app's point of view — /api/tenants always returns 200 with an
# empty array in either case, never an error).
MIMIR_ORG_ID=
